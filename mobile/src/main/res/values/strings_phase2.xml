    <string name="hc_rationale_title">Health data privacy</string>
    <string name="hc_rationale_control_title">You stay in control</string>
    <string name="hc_rationale_control_body">SportLogger requests Health Connect access only after you choose a Health Connect action. You can deny or revoke any permission in Health Connect settings.</string>
    <string name="hc_rationale_write_title">What SportLogger writes</string>
    <string name="hc_rationale_write_body">With your permission, SportLogger can publish app-owned exercise sessions and available route, heart rate, steps, distance, calories, elevation, and speed records from the canonical activity you selected.</string>
    <string name="hc_rationale_read_title">Why exercise read access may be requested</string>
    <string name="hc_rationale_read_body">Exercise read access is used only for an explicit provider-verification action that checks the app-owned exercise record and confirms an owned delete. It is not used to browse unrelated health history.</string>
    <string name="hc_rationale_delete_title">Deletion is explicit</string>
    <string name="hc_rationale_delete_body">Deleting the local SportLogger activity does not silently delete Health Connect data. Health Connect records are deleted only when you choose the separate Health Connect delete action.</string>
    <string name="hc_rationale_security_title">How data is handled</string>
    <string name="hc_rationale_security_body">Health data is sent directly to the system Health Connect provider. SportLogger does not place credentials, workout content, or Health Connect records in logs.</string>
